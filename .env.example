# ---------------------------------------------------------------------------
# Google Ads MCP server — environment variables
#
# Copy to .env for local development. On Railway, set these as service
# variables. NEVER commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# --- Google OAuth (Web application client) ---------------------------------
# From Google Cloud Console → APIs & Services → Credentials.
GOOGLE_ADS_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your-client-secret

# Must match an Authorized redirect URI on the OAuth client exactly.
GOOGLE_REDIRECT_URI=https://g-ads-production.up.railway.app/oauth2callback

# --- Google Ads API ---------------------------------------------------------
# From Google Ads → Tools & Settings → API Center (manager account).
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token

# Manager (MCC) account ID that the API calls are made through, digits only.
# Leave blank only if you authenticate directly against a standalone account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# Obtained by visiting GET /auth on this server and completing consent.
# Empty on first deploy — the server still boots so you can run the flow.
GOOGLE_ADS_REFRESH_TOKEN=

# --- Setup password ----------------------------------------------------------
# Gates GET /auth (displays a Google Ads refresh token) and is the password on
# the MCP connector's consent page. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=generate-a-long-random-token

# --- MCP OAuth (protects POST /mcp) ------------------------------------------
# Paste the client ID and secret into the Claude connector's advanced settings.
# All three are required; without them /mcp refuses every request.
# Generate the secrets with: openssl rand -hex 32
MCP_OAUTH_CLIENT_ID=claude-google-ads
MCP_OAUTH_CLIENT_SECRET=generate-a-long-random-secret
# Signs access and refresh tokens. Rotate it to revoke every token.
MCP_OAUTH_SIGNING_SECRET=generate-another-long-random-secret
# Optional. Defaults to Claude's callback URLs.
# MCP_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
# Optional. Defaults to the origin of GOOGLE_REDIRECT_URI.
# PUBLIC_BASE_URL=https://g-ads-production.up.railway.app

# --- Write access --------------------------------------------------------------
# Accounts the write tools may change, each with a monthly spend cap in the
# account's own currency. Every other account stays read-only.
# GOOGLE_ADS_WRITE_ACCOUNTS=937-504-8103:400

# --- Optional ---------------------------------------------------------------
# Railway injects PORT automatically; only set this for local development.
# PORT=8080
# LOG_LEVEL=info

# Requests per minute per IP on /mcp. A quota backstop,
# not access control. Set to 0 to disable. Default: 120
# MCP_RATE_LIMIT_PER_MINUTE=120
